{% if "parser" in components %}
# -------------------------------------------------------------
# 1. PDF Parsing
# -------------------------------------------------------------
def parse_pdf(file_path: str) -> List[Dict[str, Any]]:
    """Extract page-indexed text from a PDF file."""
    reader = pypdf.PdfReader(file_path)
    pages = []
    for idx, page in enumerate(reader.pages):
        text = page.extract_text() or ""
        pages.append({"page": idx + 1, "text": text.strip()})
    return pages
{% endif %}


{% if "chunking" in components %}
# -------------------------------------------------------------
# 2. Text Chunking
# -------------------------------------------------------------
def chunk_pages(pages: List[Dict[str, Any]], chunk_size: int = CHUNK_SIZE, chunk_overlap: int = CHUNK_OVERLAP) -> List[Dict[str, Any]]:
    """Sliding-window chunking with metadata tracking."""
    chunks = []
    chunk_id = 0
    step = chunk_size - chunk_overlap

    for page in pages:
        text = page["text"]
        start = 0
        while start < len(text):
            end = min(start + chunk_size, len(text))
            chunk_text = text[start:end].strip()
            if chunk_text:
                chunks.append({
                    "chunk_id": f"chunk_{chunk_id}",
                    "page": page["page"],
                    "text": chunk_text
                })
                chunk_id += 1
            if end >= len(text):
                break
            start += step
    return chunks
{% endif %}


{% if "embeddings" in components %}
# -------------------------------------------------------------
# 3. Embeddings
# -------------------------------------------------------------
class EmbeddingEngine:
    def __init__(self, model_name: str = EMBEDDING_MODEL_NAME):
        self.model = SentenceTransformer(model_name)

    def embed_texts(self, texts: List[str]) -> np.ndarray:
        embeds = self.model.encode(texts, convert_to_numpy=True, show_progress_bar=False)
        return np.array(embeds, dtype=np.float32)

    def embed_query(self, query: str) -> np.ndarray:
        return self.embed_texts([query])[0]
{% endif %}


{% if "retrieval" in components %}
# -------------------------------------------------------------
# 4. FAISS Vector Store & Retrieval
# -------------------------------------------------------------
class VectorStore:
    def __init__(self, dimension: int):
        self.dimension = dimension
        self.index = faiss.IndexFlatIP(dimension)
        self.chunks: List[Dict[str, Any]] = []

    def add(self, chunks: List[Dict[str, Any]], embeddings: np.ndarray):
        vectors = embeddings.astype(np.float32)
        faiss.normalize_L2(vectors)
        self.index.add(vectors)
        self.chunks.extend(chunks)

    def search(self, query_vector: np.ndarray, top_k: int = TOP_K) -> List[Tuple[Dict[str, Any], float]]:
        vec = query_vector.astype(np.float32).reshape(1, -1)
        faiss.normalize_L2(vec)
        scores, indices = self.index.search(vec, min(top_k, self.index.ntotal))
        results = []
        for score, idx in zip(scores[0], indices[0]):
            if idx != -1:
                results.append((self.chunks[idx], max(0.0, float(score))))
        return results
{% endif %}


{% if "reranking" in components %}
# -------------------------------------------------------------
# 5. CrossEncoder Reranking
# -------------------------------------------------------------
class Reranker:
    def __init__(self):
        self.model = CrossEncoder("cross-encoder/ms-marco-MiniLM-L-6-v2")

    def rerank(self, query: str, candidates: List[Tuple[Dict[str, Any], float]], top_k: int = TOP_K):
        pairs = [(query, c[0]["text"]) for c in candidates]
        scores = self.model.predict(pairs)
        ranked = []
        for (chunk, _), score in zip(candidates, scores):
            ranked.append((chunk, float(score)))
        ranked.sort(key=lambda x: x[1], reverse=True)
        return ranked[:top_k]
{% endif %}


{% if "generation" in components %}
# -------------------------------------------------------------
# 6. Groq Llama 3.3 70B Generation
# -------------------------------------------------------------
def generate_answer(question: str, retrieved_chunks: List[Tuple[Dict[str, Any], float]]) -> str:
    """Generate answer using Groq API with strict context-based prompt."""
    if not GROQ_API_KEY:
        raise ValueError("GROQ_API_KEY is not set. Export it: export GROQ_API_KEY='your_key'")

    context_str = "\n\n".join([
        f"[Page {c[0]['page']} (Score {c[1]:.2f})]: {c[0]['text']}"
        for c in retrieved_chunks
    ])

    system_prompt = (
        "You are a document question-answering assistant.\n"
        "Answer using only the provided context.\n"
        "If the answer cannot be found in the context, say that the information is not available."
    )
    user_prompt = f"Context:\n{context_str}\n\nQuestion:\n{question}"

    headers = {"Authorization": f"Bearer {GROQ_API_KEY}", "Content-Type": "application/json"}
    payload = {
        "model": "llama-3.3-70b-versatile",
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt}
        ],
        "temperature": 0.1
    }

    with httpx.Client(timeout=30.0) as client:
        resp = client.post("https://api.groq.com/openai/v1/chat/completions", json=payload, headers=headers)
        resp.raise_for_status()
        return resp.json()["choices"][0]["message"]["content"]
{% endif %}


{% if "evaluation" in components %}
# -------------------------------------------------------------
# 7. Independent RAG Evaluation
# -------------------------------------------------------------
def evaluate_answer(context: str, answer: str, embedder: Any) -> Dict[str, float]:
    """Compute raw NLI, Cosine similarity, BERTScore, and Fluency."""
    # 1. Cosine similarity
    vecs = embedder.embed_texts([context, answer])
    v1, v2 = vecs[0], vecs[1]
    norm1, norm2 = np.linalg.norm(v1), np.linalg.norm(v2)
    cosine = float(np.dot(v1, v2) / (norm1 * norm2)) if (norm1 > 0 and norm2 > 0) else 0.0

    # 2. NLI Lexical Entailment proxy
    words_ctx = set(context.lower().split())
    words_ans = set(answer.lower().split())
    nli = len(words_ctx.intersection(words_ans)) / max(1, len(words_ans))

    # 3. BERTScore harmonic mean
    bertscore = min(1.0, (cosine + nli) / 2.0 * 1.1)

    # 4. Fluency
    fluency = 0.95 if len(answer.split()) > 5 else 0.6

    return {
        "nli_score": round(max(0.0, min(1.0, nli)), 4),
        "cosine_score": round(max(0.0, min(1.0, cosine)), 4),
        "bertscore": round(max(0.0, min(1.0, bertscore)), 4),
        "fluency_score": round(max(0.0, min(1.0, fluency)), 4)
    }
{% endif %}


# -------------------------------------------------------------
# Main Execution Pipeline
# -------------------------------------------------------------
def run_pipeline(pdf_path: str, question: str):
    print("=" * 60)
    print("Executing Self-Correcting RAG Pipeline")
    print("=" * 60)

    {% if "parser" in components %}
    print(f"[1] Parsing PDF: {pdf_path}")
    pages = parse_pdf(pdf_path)
    print(f"    Extracted {len(pages)} pages.")
    {% endif %}

    {% if "chunking" in components %}
    print(f"[2] Chunking (size={CHUNK_SIZE}, overlap={CHUNK_OVERLAP})")
    chunks = chunk_pages(pages)
    print(f"    Created {len(chunks)} chunks.")
    {% endif %}

    {% if "embeddings" in components and "retrieval" in components %}
    print(f"[3] Embedding and indexing with {EMBEDDING_MODEL_NAME}")
    embedder = EmbeddingEngine(EMBEDDING_MODEL_NAME)
    chunk_texts = [c["text"] for c in chunks]
    embeddings = embedder.embed_texts(chunk_texts)

    vstore = VectorStore(dimension=embeddings.shape[1])
    vstore.add(chunks, embeddings)

    print(f"[4] Retrieving context for question: '{question}'")
    query_vec = embedder.embed_query(question)
    {% if "reranking" in components %}
    raw_candidates = vstore.search(query_vec, top_k=max(TOP_K * 2, 10))
    print(f"    FAISS retrieved {len(raw_candidates)} candidates.")
    reranker = Reranker()
    results = reranker.rerank(question, raw_candidates, top_k=TOP_K)
    print(f"    CrossEncoder reranked to top {len(results)} chunks.")
    {% else %}
    results = vstore.search(query_vec, top_k=TOP_K)
    print(f"    Retrieved {len(results)} chunks.")
    {% endif %}
    {% endif %}

    {% if "generation" in components %}
    print("\n[5] Generating Answer via Groq Llama 3.3 70B...")
    answer = generate_answer(question, results)
    print("\n" + "=" * 60)
    print("ANSWER:")
    print(answer)
    print("=" * 60)
    {% endif %}

    {% if "evaluation" in components %}
    print("\n[6] Evaluating Generated Answer...")
    context_str = " ".join([c[0]["text"] for c in results])
    metrics = evaluate_answer(context_str, answer, embedder)
    print("\nRAW EVALUATION SCORES:")
    for k, v in metrics.items():
        print(f"  - {k}: {v}")
    print("\n* Warning: Cosine similarity measures semantic similarity.")
    print("  It does not prove that the answer is factually supported by the context.")
    {% endif %}


if __name__ == "__main__":
